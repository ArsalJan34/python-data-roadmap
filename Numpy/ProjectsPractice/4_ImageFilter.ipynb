   "metadata": {},
   "outputs": [],
   "source": [
    "image = np.array([\n",
    "  [0,0,0,0,0],\n",
    "  [0,255,255,255,0],\n",
    "  [0,255,0,255,0],\n",
    "  [0,255,255,255,0],\n",
    "  [0,0,0,0,0]\n",
    "])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "e85f7884",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Original:\n",
      " [[  0   0   0   0   0]\n",
      " [  0 255 255 255   0]\n",
      " [  0 255   0 255   0]\n",
      " [  0 255 255 255   0]\n",
      " [  0   0   0   0   0]]\n"
     ]
    }
   ],
   "source": [
    "print(\"Original:\\n\",image)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "500c5792",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
